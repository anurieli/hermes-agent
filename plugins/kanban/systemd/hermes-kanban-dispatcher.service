[Unit]
Description=Hermes Kanban dispatcher (restart-safe independent supervisor)
Documentation=https://hermes-agent.nousresearch.com/docs/user-guide/features/kanban
After=network.target

[Service]
Type=simple
# This unit is the dispatch owner. Set kanban.dispatch_in_gateway=false in
# config.yaml; the gateway may keep kanban.notifier_in_gateway=true.
ExecStart=/usr/bin/env hermes kanban daemon --force --interval 10 --pidfile %t/hermes-kanban-dispatcher.pid
Restart=always
RestartSec=2
# Workers are child processes but own durable task_runs rows/checkpoints. Stop
# or restart only the daemon main process; in-flight workers remain alive and
# are rediscovered from their persisted PID/run metadata by the new daemon.
KillMode=process
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
